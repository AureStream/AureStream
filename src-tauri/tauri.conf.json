{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AureStream",
  "version": "0.3.5",
  "identifier": "com.root.aurestream",
  "build": {
    "beforeDevCommand": "pnpm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "AureStream",
        "width": 375,
        "height": 667,
        "minWidth": 375,
        "minHeight": 667,
        "maxWidth": 375,
        "maxHeight": 667,
        "resizable": false,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [
      "resources/**/*"
    ],
    "externalBin": [
      "binaries/aurestream-core"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "desktopTemplate": "resources/main.desktop",
        "files": {
          "/usr/lib/AureStream/aurestream-tun-helper": "../crates/aurestream-platform-tun/linux-helper/aurestream-tun-helper",
          "/usr/share/polkit-1/actions/com.root.aurestream.policy": "../crates/aurestream-platform-tun/linux-helper/com.root.aurestream.policy",
          "/etc/polkit-1/rules.d/49-aurestream.rules": "../crates/aurestream-platform-tun/linux-helper/49-aurestream.rules"
        },
        "postInstallScript": "resources/linux/deb-postinst.sh",
        "postRemoveScript": "resources/linux/deb-postrm.sh"
      },
      "rpm": {
        "desktopTemplate": "resources/main.desktop",
        "files": {
          "/usr/lib/AureStream/aurestream-tun-helper": "../crates/aurestream-platform-tun/linux-helper/aurestream-tun-helper",
          "/usr/share/polkit-1/actions/com.root.aurestream.policy": "../crates/aurestream-platform-tun/linux-helper/com.root.aurestream.policy",
          "/etc/polkit-1/rules.d/49-aurestream.rules": "../crates/aurestream-platform-tun/linux-helper/49-aurestream.rules"
        }
      }
    }
  },
  "plugins": {}
}
