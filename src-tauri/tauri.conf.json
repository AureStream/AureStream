{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AureStream",
  "version": "0.3.5",
  "identifier": "com.root.aurestream",
  "build": {
    "beforeDevCommand": "pnpm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "AureStream",
        "width": 375,
        "height": 667,
        "minWidth": 375,
        "minHeight": 667,
        "maxWidth": 375,
        "maxHeight": 667,
        "resizable": false,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "resources": [
      "resources/**/*"
    ],
    "externalBin": [
      "binaries/aurestream-core"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "desktopTemplate": "resources/main.desktop",
        "files": {
          "/usr/lib/AureStream/aurestream-tun-helper": "../target/release/aurestream-tun-helper",
          "/etc/systemd/system/aurestream-tun.socket": "../crates/aurestream-platform-tun/linux-helper/aurestream-tun.socket",
          "/etc/systemd/system/aurestream-tun.service": "../crates/aurestream-platform-tun/linux-helper/aurestream-tun.service",
          "/usr/share/polkit-1/actions/com.root.aurestream.policy": "../crates/aurestream-platform-tun/linux-helper/com.root.aurestream.policy",
          "/etc/polkit-1/rules.d/49-aurestream.rules": "../crates/aurestream-platform-tun/linux-helper/49-aurestream.rules"
        },
        "postInstallScript": "resources/linux/deb-postinst.sh",
        "postRemoveScript": "resources/linux/deb-postrm.sh"
      },
      "rpm": {
        "desktopTemplate": "resources/main.desktop",
        "files": {
          "/usr/lib/AureStream/aurestream-tun-helper": "../target/release/aurestream-tun-helper",
          "/etc/systemd/system/aurestream-tun.socket": "../crates/aurestream-platform-tun/linux-helper/aurestream-tun.socket",
          "/etc/systemd/system/aurestream-tun.service": "../crates/aurestream-platform-tun/linux-helper/aurestream-tun.service",
          "/usr/share/polkit-1/actions/com.root.aurestream.policy": "../crates/aurestream-platform-tun/linux-helper/com.root.aurestream.policy",
          "/etc/polkit-1/rules.d/49-aurestream.rules": "../crates/aurestream-platform-tun/linux-helper/49-aurestream.rules"
        }
      }
    },
    "macOS": {
      "infoPlist": "Info.privileged-helper.plist",
      "files": {
        "Library/LaunchServices/com.root.aurestream.helper": "target/helper/com.root.aurestream.helper",
        "MacOS/geoip.dat": "resources/geoip.dat",
        "MacOS/geosite.dat": "resources/geosite.dat"
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://cdn.jsdelivr.net/gh/AureStream/AureStream@updater/latest.json",
        "https://github.com/AureStream/AureStream/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDhCMjBBNTE3QzYxRjZBN0YKUldSL2FoL0dGNlVnaTVHZjBSdE5GVHY5ekFqUGRQTVZHK1dVT2pMM3VraFhVUFBkL0NET01ncmMK"
    }
  }
}
