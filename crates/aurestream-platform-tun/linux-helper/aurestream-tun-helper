#!/bin/sh
# AureStream TUN helper — privileged ops via pkexec.
# Installed to /usr/lib/AureStream/aurestream-tun-helper by deb/rpm.
#
# Design: one elevated start-tun session owns the full lifecycle
# (cleanup → core → wait API → DNS → watchdog). The desktop app should
# stop by signaling that process (TERM) so disconnect needs no second
# password. stop-tun remains as a fallback after app restart / lost child.
set -e

HELPER_DIR="/usr/lib/AureStream"
SELF="${HELPER_DIR}/aurestream-tun-helper"
TRUSTED_CORE="${HELPER_DIR}/aurestream-core"
PACKAGED_CORE="/usr/bin/aurestream-core"
TRUSTED_ASSETS="${HELPER_DIR}/resources"
POLKIT_ACTION="/usr/share/polkit-1/actions/com.root.aurestream.policy"
POLKIT_RULE="/etc/polkit-1/rules.d/49-aurestream.rules"
ORPHAN_TIMER_UNIT="aurestream-tun-orphan.timer"
ORPHAN_SERVICE_UNIT="aurestream-tun-orphan.service"
SYSTEMD_DIR="/etc/systemd/system"
RUNTIME_DIR="/run/aurestream-tun"
READY_TOKEN="aurestream-tun-ready"
# ~60s at 150ms polls — matches Rust READY_TIMEOUT.
API_READY_MAX_ATTEMPTS=400

ensure_runtime_dir() {
    install -d -o root -g root -m 700 "$RUNTIME_DIR"
    : > "$RUNTIME_DIR/.lock"
    chmod 600 "$RUNTIME_DIR/.lock"
}

lock_state() {
    ensure_runtime_dir
    exec 9>"$RUNTIME_DIR/.lock"
    flock -x 9
}

unlock_state() {
    flock -u 9
}

validate_pid() {
    case "$1" in
        *[!0-9]*|''|0|1) return 1 ;;
        *) return 0 ;;
    esac
}

validate_port() {
    case "$1" in
        *[!0-9]*|''|0) return 1 ;;
        *)
            # shell ports are 1..65535
            [ "$1" -ge 1 ] 2>/dev/null && [ "$1" -le 65535 ] 2>/dev/null
            ;;
    esac
}

validate_iface() {
    case "$1" in
        ''|*[!A-Za-z0-9_.:-]*|[-.:]*) return 1 ;;
        *) return 0 ;;
    esac
}

validate_dns_server() {
    case "$1" in
        ''|*[!0-9A-Fa-f:.]*) return 1 ;;
        *) return 0 ;;
    esac
}

caller_start_time() {
    awk '{print $22}' "/proc/$1/stat" 2>/dev/null
}

validate_caller() {
    caller_pid="$1"
    caller_uid="${PKEXEC_UID:-}"
    validate_pid "$caller_pid" || return 1
    case "$caller_uid" in
        *[!0-9]*|'') return 1 ;;
    esac
    [ -d "/proc/$caller_pid" ] || return 1
    [ "$(stat -c '%u' "/proc/$caller_pid" 2>/dev/null)" = "$caller_uid" ] || return 1
    caller_start_time "$caller_pid"
}

caller_is_alive() {
    caller_pid="$1"
    caller_uid="$2"
    expected_start="$3"
    [ -d "/proc/$caller_pid" ] || return 1
    [ "$(stat -c '%u' "/proc/$caller_pid" 2>/dev/null)" = "$caller_uid" ] || return 1
    [ "$(caller_start_time "$caller_pid")" = "$expected_start" ]
}

restore_session_dns() {
    session_dir="$1"
    [ -f "$session_dir/dns-active" ] || return 0
    iface=$(sed -n '1p' "$session_dir/iface" 2>/dev/null || true)
    validate_iface "$iface" || return 0
    if [ -s "$session_dir/original-dns" ]; then
        dns_args=""
        while IFS= read -r server; do
            validate_dns_server "$server" || continue
            dns_args="$dns_args $server"
        done < "$session_dir/original-dns"
        if [ -n "$dns_args" ]; then
            # Intentional word splitting: every entry was validated above.
            # shellcheck disable=SC2086
            resolvectl dns "$iface" $dns_args 2>/dev/null || true
        else
            resolvectl revert "$iface" 2>/dev/null || true
        fi
    else
        resolvectl revert "$iface" 2>/dev/null || true
    fi
    resolvectl flush-caches 2>/dev/null || true
    rm -f "$session_dir/dns-active"
}

remove_session() {
    session_dir="$1"
    restore_session_dns "$session_dir"
    rm -f "$session_dir/caller-uid" "$session_dir/caller-start" \
        "$session_dir/core-pid" "$session_dir/iface" \
        "$session_dir/original-dns" "$session_dir/dns-active" \
        "$session_dir/config.json"
    rmdir "$session_dir" 2>/dev/null || true
}

stop_core_pid() {
    core_pid="$1"
    validate_pid "$core_pid" || return 0
    kill -TERM "$core_pid" 2>/dev/null || true
    attempts=0
    while kill -0 "$core_pid" 2>/dev/null && [ "$attempts" -lt 30 ]; do
        sleep 0.1
        attempts=$((attempts + 1))
    done
    kill -KILL "$core_pid" 2>/dev/null || true
}

pkill_cores() {
    pkill -x aurestream-core 2>/dev/null || true
    pkill -f '/aurestream-core(-[a-z0-9_]+)*$' 2>/dev/null || true
    # also match debug path binaries
    pkill -f 'target/.*/aurestream-core' 2>/dev/null || true
}

# Tear down every recorded session + leftover cores (used by start and stop).
teardown_all_sessions() {
    for session_dir in "$RUNTIME_DIR"/session-*; do
        [ -d "$session_dir" ] || continue
        core_pid=$(sed -n '1p' "$session_dir/core-pid" 2>/dev/null || true)
        restore_session_dns "$session_dir"
        stop_core_pid "$core_pid"
        remove_session "$session_dir"
    done
    pkill_cores
}

# Portable localhost TCP probe (dash has no /dev/tcp).
probe_localhost_port() {
    port="$1"
    if command -v bash >/dev/null 2>&1; then
        bash -c "exec 3<>/dev/tcp/127.0.0.1/$port" 2>/dev/null && return 0
    fi
    if command -v nc >/dev/null 2>&1; then
        nc -z 127.0.0.1 "$port" >/dev/null 2>&1 && return 0
    fi
    if command -v ss >/dev/null 2>&1; then
        ss -lnt 2>/dev/null | grep -E ":${port}\\s" >/dev/null 2>&1 && return 0
    fi
    return 1
}

wait_api_ready() {
    port="$1"
    core_pid="$2"
    attempts=0
    while [ "$attempts" -lt "$API_READY_MAX_ATTEMPTS" ]; do
        if ! kill -0 "$core_pid" 2>/dev/null; then
            return 1
        fi
        if probe_localhost_port "$port"; then
            return 0
        fi
        sleep 0.15
        attempts=$((attempts + 1))
    done
    return 1
}

apply_session_dns() {
    session_dir="$1"
    iface="$2"
    gateway="$3"
    validate_iface "$iface" || return 1
    validate_dns_server "$gateway" || return 1
    # Record restore intent before changing the OS.
    : > "$session_dir/dns-active"
    chmod 600 "$session_dir/dns-active"
    resolvectl dns "$iface" "$gateway"
    resolvectl flush-caches 2>/dev/null || true
}

# Return 0 if the AureStream main app (or package) still appears installed.
is_main_app_present() {
    # Running main process
    if pgrep -x aurestream >/dev/null 2>&1; then
        return 0
    fi
    # Common install layouts (deb/rpm /opt /usr)
    for p in \
        /usr/bin/aurestream \
        /usr/bin/AureStream \
        /opt/AureStream/aurestream \
        /opt/AureStream/bin/aurestream \
        /usr/lib/AureStream/aurestream \
        /usr/share/applications/aurestream.desktop \
        /usr/share/applications/AureStream.desktop
    do
        if [ -e "$p" ]; then
            return 0
        fi
    done
    # dpkg/rpm package still registered
    if command -v dpkg-query >/dev/null 2>&1; then
        if dpkg-query -W -f='${Status}' aurestream 2>/dev/null | grep -q "install ok installed"; then
            return 0
        fi
        if dpkg-query -W -f='${Status}' AureStream 2>/dev/null | grep -q "install ok installed"; then
            return 0
        fi
    fi
    if command -v rpm >/dev/null 2>&1; then
        if rpm -q aurestream >/dev/null 2>&1 || rpm -q AureStream >/dev/null 2>&1; then
            return 0
        fi
    fi
    return 1
}

do_uninstall() {
    "$0" stop-tun 2>/dev/null || true
    # Drop orphan timer if present
    if command -v systemctl >/dev/null 2>&1; then
        systemctl disable --now "$ORPHAN_TIMER_UNIT" 2>/dev/null || true
        rm -f "${SYSTEMD_DIR}/${ORPHAN_TIMER_UNIT}" "${SYSTEMD_DIR}/${ORPHAN_SERVICE_UNIT}"
        systemctl daemon-reload 2>/dev/null || true
    fi
    rm -f "$SELF" "$TRUSTED_CORE" "$POLKIT_ACTION" "$POLKIT_RULE"
    rm -f "$TRUSTED_ASSETS/geoip.dat" "$TRUSTED_ASSETS/geosite.dat"
    rm -rf "$RUNTIME_DIR"
    rmdir "$TRUSTED_ASSETS" 2>/dev/null || true
    rmdir "$HELPER_DIR" 2>/dev/null || true
    exit 0
}

# If main app is gone, remove this helper (no-op when app still present).
do_orphan_check() {
    if is_main_app_present; then
        echo "main app present — keep helper"
        exit 0
    fi
    echo "main app missing — uninstalling orphan helper" >&2
    do_uninstall
}

install_orphan_timer() {
    if ! command -v systemctl >/dev/null 2>&1; then
        return 0
    fi
    cat > "${SYSTEMD_DIR}/${ORPHAN_SERVICE_UNIT}" <<EOF
[Unit]
Description=AureStream TUN helper orphan cleanup
ConditionPathExists=${SELF}

[Service]
Type=oneshot
ExecStart=${SELF} orphan-check
EOF
    cat > "${SYSTEMD_DIR}/${ORPHAN_TIMER_UNIT}" <<EOF
[Unit]
Description=Periodic AureStream TUN helper orphan check

[Timer]
OnBootSec=5min
OnUnitActiveSec=30min
Persistent=true

[Install]
WantedBy=timers.target
EOF
    systemctl daemon-reload 2>/dev/null || true
    systemctl enable --now "$ORPHAN_TIMER_UNIT" 2>/dev/null || true
}

# Resolve a kernel identifier to a root-owned executable. Never execute a path
# supplied by the pkexec caller: this helper runs as root.
resolve_kernel() {
    case "$1" in
        xray)
            for candidate in "$TRUSTED_CORE" "$PACKAGED_CORE"; do
                mode=$(stat -c '%a' "$candidate" 2>/dev/null || true)
                if [ -f "$candidate" ] && [ -x "$candidate" ] &&
                   [ ! -L "$candidate" ] &&
                   [ "$(stat -c '%u' "$candidate" 2>/dev/null)" = "0" ] &&
                   [ -n "$mode" ] && [ $((0$mode & 0022)) -eq 0 ]; then
                    printf '%s\n' "$candidate"
                    return 0
                fi
            done
            echo "trusted xray kernel is not installed" >&2
            return 1
            ;;
        *)
            echo "unsupported kernel id: $1" >&2
            return 1
            ;;
    esac
}

# Only accept the app-owned config for the desktop user that invoked pkexec.
# Canonicalization and the exact path allowlist prevent symlink escapes.
resolve_config() {
    requested="$1"
    uid="${PKEXEC_UID:-}"
    if [ -z "$requested" ] || [ -z "$uid" ]; then
        echo "missing config path or PKEXEC_UID" >&2
        return 1
    fi
    case "$uid" in
        *[!0-9]*|'') echo "invalid PKEXEC_UID" >&2; return 1 ;;
    esac
    home_dir=$(getent passwd "$uid" 2>/dev/null | cut -d: -f6)
    canonical=$(readlink -f -- "$requested" 2>/dev/null || true)
    if [ -z "$home_dir" ] || [ -z "$canonical" ] || [ ! -f "$canonical" ] || [ -L "$requested" ]; then
        echo "config path is not a regular canonical file" >&2
        return 1
    fi
    case "$canonical" in
        "$home_dir/.local/share/com.root.aurestream/xray-config.json"|\
        "$home_dir/.config/com.root.aurestream/xray-config.json"|\
        "/run/user/$uid/com.root.aurestream/xray-config.json") ;;
        *) echo "config path is outside AureStream app data" >&2; return 1 ;;
    esac
    if [ "$(stat -c '%u' "$canonical" 2>/dev/null)" != "$uid" ]; then
        echo "config file is not owned by the invoking user" >&2
        return 1
    fi
    printf '%s\n' "$canonical"
}

case "$1" in
    start-tun)
        # $2 = kernel id
        # $3 = config path
        # $4 = caller pid
        # $5 = api port (wait until ready before DNS / ready token)
        # $6 = dns gateway (e.g. 1.1.1.1); ignored when iface omitted
        # $7 = interface (optional)
        # $8... = original DNS servers for restore
        #
        # Full lifecycle stays in this single elevated process so the app only
        # needs one polkit password to connect.
        kernel_id="$2"
        requested_config="$3"
        caller_pid="$4"
        api_port="$5"
        dns_gateway="$6"
        iface="${7:-}"
        if [ -z "$kernel_id" ] || [ -z "$requested_config" ] || [ -z "$caller_pid" ] || \
           [ -z "$api_port" ] || [ -z "$dns_gateway" ]; then
            echo "start-tun requires kernel id, config, caller pid, api port, and dns gateway" >&2
            exit 2
        fi
        validate_port "$api_port" || { echo "invalid api port" >&2; exit 2; }
        validate_dns_server "$dns_gateway" || { echo "invalid dns gateway" >&2; exit 2; }
        sidecar=$(resolve_kernel "$kernel_id") || exit 3
        config=$(resolve_config "$requested_config") || exit 4
        caller_start=$(validate_caller "$caller_pid") || {
            echo "caller pid is not owned by PKEXEC_UID" >&2
            exit 5
        }
        caller_uid="$PKEXEC_UID"
        if [ -n "$iface" ]; then
            validate_iface "$iface" || { echo "invalid interface" >&2; exit 6; }
            shift 7
            for server in "$@"; do
                validate_dns_server "$server" || { echo "invalid DNS server" >&2; exit 6; }
            done
        else
            shift 6
            # No leftover original-dns args when iface is absent.
            set --
        fi
        # Best-effort: ensure orphan timer is armed after first privileged use.
        install_orphan_timer 2>/dev/null || true
        if [ -d "$TRUSTED_ASSETS" ]; then
            export XRAY_LOCATION_ASSET="$TRUSTED_ASSETS"
            cd "$TRUSTED_ASSETS"
        else
            side_dir=$(dirname "$sidecar")
            export XRAY_LOCATION_ASSET="$side_dir"
            cd "$side_dir"
        fi

        # Previous TUN session cleanup inside this same elevation — no extra pkexec.
        lock_state
        teardown_all_sessions
        unlock_state

        lock_state
        session_dir="$RUNTIME_DIR/session-$caller_pid"
        if [ -d "$session_dir" ]; then
            old_core=$(sed -n '1p' "$session_dir/core-pid" 2>/dev/null || true)
            stop_core_pid "$old_core"
            remove_session "$session_dir"
        fi
        install -d -o root -g root -m 700 "$session_dir"
        install -o root -g root -m 600 "$config" "$session_dir/config.json"
        "$sidecar" run -c "$session_dir/config.json" &
        core_pid=$!
        printf '%s\n' "$caller_uid" > "$session_dir/caller-uid"
        printf '%s\n' "$caller_start" > "$session_dir/caller-start"
        printf '%s\n' "$core_pid" > "$session_dir/core-pid"
        printf '%s\n' "$iface" > "$session_dir/iface"
        : > "$session_dir/original-dns"
        for server in "$@"; do
            printf '%s\n' "$server" >> "$session_dir/original-dns"
        done
        chmod 600 "$session_dir"/*
        unlock_state

        cleanup_requested=0
        trap 'cleanup_requested=1' HUP INT TERM

        if ! wait_api_ready "$api_port" "$core_pid"; then
            echo "core API :${api_port} not ready" >&2
            stop_core_pid "$core_pid"
            lock_state
            remove_session "$session_dir"
            unlock_state
            exit 7
        fi

        if [ -n "$iface" ]; then
            if ! apply_session_dns "$session_dir" "$iface" "$dns_gateway"; then
                echo "dns-override failed for iface=${iface}" >&2
                stop_core_pid "$core_pid"
                lock_state
                remove_session "$session_dir"
                unlock_state
                exit 8
            fi
        fi

        # Tell the unprivileged parent that core + DNS are ready.
        # Must be a single line token; parent waits for this before returning Ok.
        printf '%s\n' "$READY_TOKEN"

        while kill -0 "$core_pid" 2>/dev/null; do
            if [ "$cleanup_requested" -eq 1 ] || \
               ! caller_is_alive "$caller_pid" "$caller_uid" "$caller_start"; then
                stop_core_pid "$core_pid"
                break
            fi
            sleep 1
        done
        core_status=0
        wait "$core_pid" || core_status=$?
        lock_state
        remove_session "$session_dir"
        unlock_state
        exit "$core_status"
        ;;
    stop-tun)
        lock_state
        teardown_all_sessions
        unlock_state
        exit 0
        ;;
    dns-override)
        # Kept for compatibility / manual recovery. Normal start applies DNS
        # inside start-tun so no second polkit prompt is required.
        # $2 = iface, $3 = gateway, $4 = caller pid.
        iface="$2"
        gateway="$3"
        caller_pid="$4"
        if ! validate_iface "$iface" || ! validate_dns_server "$gateway" || \
           ! validate_pid "$caller_pid"; then
            echo "dns-override requires valid iface, gateway, and caller pid" >&2
            exit 2
        fi
        lock_state
        session_dir="$RUNTIME_DIR/session-$caller_pid"
        if [ ! -d "$session_dir" ]; then
            unlock_state
            echo "active TUN session not found" >&2
            exit 3
        fi
        core_pid=$(sed -n '1p' "$session_dir/core-pid" 2>/dev/null || true)
        caller_uid=$(sed -n '1p' "$session_dir/caller-uid" 2>/dev/null || true)
        caller_start=$(sed -n '1p' "$session_dir/caller-start" 2>/dev/null || true)
        session_iface=$(sed -n '1p' "$session_dir/iface" 2>/dev/null || true)
        if [ "${PKEXEC_UID:-}" != "$caller_uid" ] || [ "$iface" != "$session_iface" ] || \
           ! kill -0 "$core_pid" 2>/dev/null || \
           ! caller_is_alive "$caller_pid" "$caller_uid" "$caller_start"; then
            remove_session "$session_dir"
            unlock_state
            echo "TUN session is no longer alive" >&2
            exit 4
        fi
        if ! apply_session_dns "$session_dir" "$iface" "$gateway"; then
            unlock_state
            echo "dns-override failed" >&2
            exit 5
        fi
        unlock_state
        ;;
    dns-restore)
        iface="$2"
        shift 2
        if [ -z "$iface" ]; then
            echo "dns-restore requires iface" >&2
            exit 2
        fi
        if [ "$#" -eq 0 ]; then
            resolvectl revert "$iface" 2>/dev/null || true
        else
            resolvectl dns "$iface" "$@"
        fi
        resolvectl flush-caches 2>/dev/null || true
        ;;
    uninstall)
        do_uninstall
        ;;
    orphan-check)
        do_orphan_check
        ;;
    install-orphan-timer)
        install_orphan_timer
        exit 0
        ;;
    *)
        echo "Usage: $0 {start-tun|stop-tun|dns-override|dns-restore|uninstall|orphan-check|install-orphan-timer}" >&2
        exit 1
        ;;
esac
