// Polkit rule: require administrator authentication for every retained
// authorization window. The helper itself also validates every input path.
// Installed to /etc/polkit-1/rules.d/ by the deb/rpm package.
polkit.addRule(function(action, subject) {
    if (action.id === "com.root.aurestream.run-privileged" &&
        subject.local && subject.active &&
        subject.isInGroup("sudo")) {
        return polkit.Result.AUTH_ADMIN_KEEP;
    }
});
