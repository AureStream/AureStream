<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleIdentifier</key>
    <string>com.root.aurestream.helper</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    <string>AureStreamHelper</string>
    <!-- CFBundleVersion drives SMJobBless's "replace the installed helper?"
         decision. MUST be manually bumped whenever anything under
         crates/aurestream-plugin-privilege/macos-helper/ changes
         (main.m, this Info.plist, Launchd.plist),
         otherwise the new helper silently never reaches end-user machines —
         the old daemon keeps answering XPC pings and ensure_helper_installed
         treats it as up-to-date. There is no automatic sync; see the
         "Privileged helper version bump" section in CLAUDE.md. -->
    <key>CFBundleShortVersionString</key>
    <string>1.0.12</string>
    <key>CFBundleVersion</key>
    <!-- Bumped 15: pin SMAuthorizedClients to the "AureStream Code Signing"
         certificate's leaf hash instead of a bare identifier string — a bare
         `identifier "com.root.aurestream"` requirement is satisfiable by any
         local user via ad-hoc `codesign --sign - --identifier ...` (no
         certificate needed), which let any local process impersonate the
         app to this helper. Must match kClientRequirement in main.m. -->
    <string>15</string>
    <key>SMAuthorizedClients</key>
    <array>
        <string>identifier "com.root.aurestream" and certificate leaf = H"8cd4e1d490e21a4f412a8784393087d93ad15bbd"</string>
    </array>
</dict>
</plist>
